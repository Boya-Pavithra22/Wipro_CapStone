package com.wipro.ecommerce.onlineshopping.repository;

import com.wipro.ecommerce.onlineshopping.entity.Order;
import com.wipro.ecommerce.onlineshopping.entity.User;
import org.junit.jupiter.api.Test;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.jdbc.AutoConfigureTestDatabase;
import org.springframework.boot.test.autoconfigure.orm.jpa.DataJpaTest;
import org.springframework.test.context.TestPropertySource;
import org.springframework.data.domain.Page;
import org.springframework.data.domain.PageRequest;

import java.util.List;
import java.util.Optional;

import static org.assertj.core.api.Assertions.assertThat;

@DataJpaTest
@AutoConfigureTestDatabase(replace = AutoConfigureTestDatabase.Replace.NONE)
@TestPropertySource(locations = "classpath:application-test.properties")
class OrderRepositoryTest {

    @Autowired
    private OrderRepository orderRepository;

    @Autowired
    private UserRepository userRepository;

    @Test
    void testFindByUser() {
        User user = new User();
        user.setName("john_doe");
        user.setPassword("password123");
        user = userRepository.save(user);

        Order order = new Order();
        order.setUser(user);
        orderRepository.save(order);

        List<Order> orders = orderRepository.findByUser(user);

        assertThat(orders).isNotEmpty();
        assertThat(orders.get(0).getUser().getName()).isEqualTo("john_doe");
    }

    @Test
    void testFindByIdWithItems() {
        User user = new User();
        user.setName("alice");
        user.setPassword("12345");
        user = userRepository.save(user);

        Order order = new Order();
        order.setUser(user);
        order = orderRepository.save(order);

        Optional<Order> foundOrder = orderRepository.findByIdWithItems(order.getId());

        assertThat(foundOrder).isPresent();
        assertThat(foundOrder.get().getUser().getName()).isEqualTo("alice");
    }

    @Test
    void testFindByUserIdWithPagination() {
        User user = new User();
        user.setName("bob");
        user.setPassword("password");
        user = userRepository.save(user);

        Order order1 = new Order();
        order1.setUser(user);
        orderRepository.save(order1);

        Order order2 = new Order();
        order2.setUser(user);
        orderRepository.save(order2);

        Page<Order> page = orderRepository.findByUserId(user.getId(), PageRequest.of(0, 5));

        assertThat(page.getContent().size()).isEqualTo(2);
        assertThat(page.getContent().get(0).getUser().getName()).isEqualTo("bob");
    }
}
