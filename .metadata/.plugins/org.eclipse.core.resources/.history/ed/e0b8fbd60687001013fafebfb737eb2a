package com.wipro.ecommerce.onlineshopping.controller;

import com.wipro.ecommerce.onlineshopping.entity.Cart;
import com.wipro.ecommerce.onlineshopping.entity.Product;
import com.wipro.ecommerce.onlineshopping.entity.User;
import com.wipro.ecommerce.onlineshopping.service.CartService;
import org.junit.jupiter.api.Test;
import org.mockito.Mockito;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.boot.test.autoconfigure.web.servlet.WebMvcTest;
import org.springframework.boot.test.mock.mockito.MockBean;
import org.springframework.http.MediaType;
import org.springframework.test.web.servlet.MockMvc;

import java.util.Collections;

import static org.springframework.test.web.servlet.request.MockMvcRequestBuilders.*;
import static org.springframework.test.web.servlet.result.MockMvcResultMatchers.*;

@WebMvcTest(CartController.class)
class CartControllerTest {

    @Autowired
    private MockMvc mockMvc;

    @MockBean
    private CartService cartService;

    @Test
    void testAddItem() throws Exception {
        User user = new User("John", "john@example.com", "pass");
        Product product = new Product();
        product.setId(1L);

        Cart cart = new Cart(user, product, 2);
        Mockito.when(cartService.addItem(1L, 1L, 2)).thenReturn(cart);

        mockMvc.perform(post("/cart")
                        .param("userId", "1")
                        .param("productId", "1")
                        .param("quantity", "2"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.quantity").value(2));
    }

    @Test
    void testGetUserCart() throws Exception {
        Mockito.when(cartService.getUserCart(1L)).thenReturn(Collections.emptyList());

        mockMvc.perform(get("/cart/1"))
                .andExpect(status().isOk())
                .andExpect(content().json("[]"));
    }

    @Test
    void testUpdateQuantity() throws Exception {
        User user = new User("John", "john@example.com", "pass");
        Product product = new Product();
        product.setId(1L);

        Cart cart = new Cart(user, product, 5);
        Mockito.when(cartService.updateQuantity(10L, 5)).thenReturn(cart);

        mockMvc.perform(put("/cart/10").param("quantity", "5"))
                .andExpect(status().isOk())
                .andExpect(jsonPath("$.quantity").value(5));
    }

    @Test
    void testRemoveItem() throws Exception {
        mockMvc.perform(delete("/cart/10"))
                .andExpect(status().isOk())
                .andExpect(content().string("Item removed from cart"));

        Mockito.verify(cartService).removeItem(10L);
    }
}
